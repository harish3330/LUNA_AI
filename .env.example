# .env.example — copy this to .env and fill in your real values
# The .env file is gitignored and must NEVER be committed to the repository.

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=recipient@example.com

# ── Location (defaults to Paris, France) ─────────────────────────────────────
LUNA_CITY=Paris
LUNA_COUNTRY=France
LUNA_TIMEZONE=Europe/Paris
LUNA_SEND_TIME=08:00
LUNA_LATITUDE=48.8566
LUNA_LONGITUDE=2.3522
